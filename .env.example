# Supabase dashboard > Project Settings > API.
# The project URL and the publishable key are meant for the browser: row level security
# is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only used by "npm run seed" on your own machine to load the demo workspace.
# It bypasses row level security. Keep it out of any hosting environment and never commit it.
SUPABASE_SECRET_KEY=

# Optional. Password given to the demo accounts. A default is used when this is empty.
SEED_DEMO_PASSWORD=
